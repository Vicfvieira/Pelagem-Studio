# Neon: connection string COM pooling (host contém "-pooler"); usada pela aplicação
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon: connection string DIRETA (sem "-pooler"); usada pelo prisma migrate
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js: 32 bytes aleatórios em base64
AUTH_SECRET="gere-com-o-comando-do-README"
# Chave da API de integração (header x-api-key): 32 bytes em hex
INTEGRATION_API_KEY="gere-com-o-comando-do-README"
# Salt do clienteHash (SHA-256 do id + salt): 32 bytes em hex
HASH_SALT="gere-com-o-comando-do-README"

# Opcional, só para testes locais: URL base alternativa do ViaCEP (padrão: https://viacep.com.br/ws)
# VIACEP_BASE_URL="http://localhost:3999/ws"

# Opcional: domínio próprio usado em metadata, Open Graph, sitemap e JSON-LD.
# Na Vercel, sem esta variável, usa-se o domínio de produção do projeto automaticamente.
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
